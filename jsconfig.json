{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": false,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "server/**/*.js",
    "games/chessdown/engine.js",
    "games/chesspell/rules.js",
    "games/chesspell/game.js",
    "types/**/*.d.ts",
    "games/chessdown/js/**/*.js",
    "games/chessdown/confetti.js"
  ]
}
